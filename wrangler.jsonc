{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // o esbuild injetaria `__name` nas funções que o next-themes serializa para um script inline, quebrando o tema no navegador.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "individuaula-db",
      "database_id": "7a14145c-952a-42d9-8b08-ea0d54d28bee",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
